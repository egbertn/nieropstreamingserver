{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch Streaming",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/Streaming/bin/Debug/net10.0/streaming.dll",
      "cwd": "${workspaceFolder}/src/Streaming",
      "preLaunchTask": "build",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+http://(?:\\[::\\]|0\\.0\\.0\\.0):(\\d+)",
        "uriFormat": "http://localhost:%s"
      },
      "stopAtEntry": false
    }
  ]
}
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- TagLibSharp 2.3.0 contains unavoidable legacy trim warnings; its assembly is rooted below. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <UserSecretsId>2ea925af-8c22-4eba-87da-5f3cfd814e67</UserSecretsId>
  </PropertyGroup>

  <!-- Publish as one self-contained executable so the Pi needs no .NET install. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- TagLib discovers audio handlers through Activator at runtime. Keep its handlers in AOT output. -->
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Streaming.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Without this the previous publish output ends up inside the next one. -->
  <ItemGroup>
    <Content Remove="out/**" />
    <None Remove="out/**" />
  </ItemGroup>

  <!-- The music lives on the target machine; never ship the local collection. -->
  <ItemGroup>
    <Content Remove="wwwroot/music/**" />
    <None Remove="wwwroot/music/**" />
  </ItemGroup>

</Project>

[Unit]
Description=Sonos MP3 streaming service
After=network-online.target
Wants=network-online.target

[Service]
# __USER__ and __DIR__ are filled in by publish.sh.
Type=notify
WorkingDirectory=__DIR__
ExecStart=__DIR__/streaming
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PrintTelemetryMessage=false
Environment=Smtp__Host=localhost
Environment=Smtp__Port=587
Environment=Smtp__From=Music-report@local
Environment=Smtp__FromName="Sonus Muziek Server"
Environment=Smtp__UseSsl=true
Environment=Smtp__Password=
Environment=Smtp__Username=
Environment=Streaming__Playback__UseSonos=true
Environment=Streaming__Port=8080
Environment=Streaming__ApiToken=3012

# Set Streaming__ApiToken through a systemd override or environment file.
User=__USER__
Group=__USER__
SupplementaryGroups=audio
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=kestrel-music

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
